<configuration>
  <connectionStrings>
    <add name="ECommerceDB" connectionString="Data Source=INI;Initial Catalog=ECommerceDB;Integrated Security=True" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <system.web>
    <compilation debug="true"/>
  </system.web>
</configuration>